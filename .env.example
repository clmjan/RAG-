# Copy to .env before docker compose up.
DATABASE_PATH=/app/runtime/knowledge.db
UPLOAD_DIR=/app/runtime/uploads
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_METHOD=bm25
RETRIEVAL_THRESHOLD=0.08
THRESHOLD_CANDIDATES=0.05,0.08,0.12,0.16,0.20,0.25,0.30
EVIDENCE_MIN_SCORE_GAP=0.01
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0
RETRIEVAL_MAX_CANDIDATES=50
HYBRID_LEXICAL_WEIGHT=0.35
HYBRID_SEMANTIC_WEIGHT=0.65

# Optional OpenAI-compatible embedding provider. Leave blank for BM25 fallback.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30

# Optional OpenAI-compatible chat provider. Leave blank for extractive answers.
GENERATION_METHOD=extractive
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_ANSWER_CHARS=4000
LLM_MAX_CITATIONS=5
EXTRACTIVE_MAX_ANSWER_CHARS=4000
EXTRACTIVE_MAX_CITATIONS=3

LOG_LEVEL=INFO
LOG_TEXT_MAX_CHARS=1000
